{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prelaunch",
            "program": "${workspaceFolder}/src/WeightTracker.Api/bin/Debug/net10.0/WeightTracker.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/WeightTracker.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:5199"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+https?://\\S+:(\\d+)",
                "uriFormat": "http://localhost:%s/scalar"
            },
            "console": "internalConsole",
            "sourceFileMap": {
                "/_": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug API (no prelaunch)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/WeightTracker.Api/bin/Debug/net10.0/WeightTracker.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/WeightTracker.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:5199"
            },
            "console": "internalConsole"
        },
        {
            "name": "Attach to process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
