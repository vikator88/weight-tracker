<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="6.*" />
    <PackageReference Include="FluentMigrator.Runner" Version="6.*" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="6.*" />
    <PackageReference Include="FluentMigrator.Runner.SqlServer" Version="6.*" />
    <!-- FluentMigrator.Runner.Postgres resolves the Npgsql provider reflectively at
         runtime, so the driver must be referenced explicitly. -->
    <PackageReference Include="Npgsql" Version="10.0.*" />
  </ItemGroup>

</Project>
